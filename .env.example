PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_PLANNER_TIME_ZONE=America/New_York
PLANNER_USE_DEMO_DATA=true
PLANNER_TIME_ZONE=America/New_York
PLANNER_WORKDAY_START=09:00
PLANNER_WORKDAY_END=17:00

# Jira Cloud
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=

# Microsoft Graph (delegated user sign-in; no client secret)
MICROSOFT_AUTH_MODE=delegated
MICROSOFT_TENANT_ID=organizations
MICROSOFT_CLIENT_ID=
MICROSOFT_ENABLE_TEAMS_CHANNELS=false

# Optional app-only fallback (requires Entra admin consent)
# MICROSOFT_AUTH_MODE=client_credentials
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_USER_ID=you@example.com
# MICROSOFT_TOKEN_CACHE_PATH=/absolute/path/to/cache.json

DATABASE_URL=file:./planner.db
